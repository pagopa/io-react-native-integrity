PORT =
BUNDLE_IDENTIFIER = ''
TEAM_IDENTIFIER = ''

# Android
GOOGLE_APPLICATION_CREDENTIALS = ''
ANDROID_BUNDLE_IDENTIFIER = 'com.ioreactnativeintegrityexample'
# SHA-256 digests of the app signing certificates, comma separated (required to accept GrapheneOS)
ANDROID_SIGNATURE_DIGESTS = ''
# Set to 'true' to require the PLAY_RECOGNIZED app verdict (apps distributed through Google Play)
ANDROID_REQUIRE_PLAY_RECOGNIZED = 'false'
# Optional override of the pinned https://grapheneos.org/allowed_signers used to verify https://grapheneos.org/attestation.json
GRAPHENEOS_ALLOWED_SIGNERS = ''
# Optional file to persist the last verified GrapheneOS attestation keys list
GRAPHENEOS_ALLOWLIST_CACHE_FILE = ''
