{
  "name": "@pagopa/io-react-native-integrity-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "build:android": "cd android && ./gradlew assembleDebug --no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a",
    "build:ios": "cd ios && xcodebuild -workspace IoReactNativeIntegrityExample.xcworkspace -scheme IoReactNativeIntegrityExample -configuration Debug -sdk iphonesimulator CC=clang CPLUSPLUS=clang++ LD=clang LDPLUSPLUS=clang++ GCC_OPTIMIZATION_LEVEL=0 GCC_PRECOMPILE_PREFIX_HEADER=YES ASSETCATALOG_COMPILER_OPTIMIZATION=time DEBUG_INFORMATION_FORMAT=dwarf COMPILER_INDEX_STORE_ENABLE=NO"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@pagopa/io-react-native-crypto": "^1.2.5",
    "@pagopa/io-react-native-iso18013": "^0.9.0",
    "buffer": "^6.0.3",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-dotenv": "^3.4.11",
    "react-native-uuid": "^2.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.25.0",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "babel-plugin-module-resolver": "^5.0.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
